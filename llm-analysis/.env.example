# Environment Configuration for pub-analysis-agent
# Copy this file to .env and fill in your values

# =============================================================================
# DEPLOYMENT ENVIRONMENT
# =============================================================================

# Database Configuration
# ========================

# MongoDB connection string (mongodb://... or mongodb+srv://...)
# Required
MONGODB_CONNECTION_STRING=mongodb://localhost:27016/

# MongoDB database name
# Required
MONGODB_DATABASE=publication_analysis

# Elasticsearch Configuration
# =============================

# Elasticsearch password (optional for local)
# Optional
ELASTICSEARCH_PASSWORD=

# Elasticsearch cluster URL
# Required
ELASTICSEARCH_URL=https://localhost:9200

# Elasticsearch username (optional for local)
# Optional
ELASTICSEARCH_USERNAME=elastic

# LLM Service Configuration
# ===========================

# LMStudio API endpoint URL
# Optional
LMSTUDIO_ENDPOINT=http://localhost:1234/v1/

# Ollama API endpoint URL
# Optional
OLLAMA_ENDPOINT=http://localhost:11434/api

# API Keys
# ==========

# Anthropic API key for Claude models
# Optional
ANTHROPIC_API_KEY=

# OpenAI API key for GPT models
# Optional
OPENAI_API_KEY=

# Application Configuration
# ===========================

# Deployment environment
# Required
# Allowed values: development, testing, staging, production
ENVIRONMENT=development

# Directory for log files
# Optional
LOG_DIRECTORY=logs

# Logging level
# Optional
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Secret key for encryption and signing
# Required
SECRET_KEY=

# Processing Configuration
# ==========================

# Default batch size for processing
# Optional
BATCH_SIZE=50

# Maximum concurrent LLM requests
# Optional
MAX_CONCURRENT_REQUESTS=10
