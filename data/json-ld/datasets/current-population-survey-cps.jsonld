    {
      "@type": "Review",
      "reviewAspect": "join",
      "reviewBody": "The authors used CPS respondent records and classified households as ECTC or non‑ECTC based on the Census Bureau’s tax‑return simulation that estimates who received the credit for tax year 2021.",
      "citation": {
        "@type": "ScholarlyArticle",
        "name": "Expanded Child Tax Credit and Food Insecurity",
        "dud:publication_id": "pub.1174803730",
        "identifier": "10.1001/jamainternmed.2024.3972"
      },
      "dud:joinDetail": {
        "partnerDataset": "Estimated Expanded Child Tax Credit (ECTC) receipt from Census Bureau tax model",
        "joinType": "integration",
        "joinKeys": "[\"household_id\",\"year\",\"family_size\",\"total_income\",\"child_eligibility\"]",
        "methodology": "The authors linked individual CPS respondent records from the IPUMS Current Population Survey with the Census Bureau’s tax‑return simulation that estimates Expanded Child Tax Credit receipt for tax year 2021. The integration was performed by matching each CPS household to its corresponding simulated"
      },
      "reviewRating": [
        {
          "@type": "Rating",
          "name": "join_confidence",
          "ratingValue": 9.0
        }
      ]
    },
    {
      "@type": "Review",
      "reviewAspect": "join",
      "reviewBody": "Inflation was adjusted for by incorporating state‑specific PCE change values relative to 2020, which were sourced from the BEA and merged with the CPS individual records.",
      "citation": {
        "@type": "ScholarlyArticle",
        "name": "Expanded Child Tax Credit and Food Insecurity",
        "dud:publication_id": "pub.1174803730",
        "identifier": "10.1001/jamainternmed.2024.3972"
      },
      "dud:joinDetail": {
        "partnerDataset": "State‑level inflation estimates (Personal Consumption Expenditure change) from the Bureau of Economic Analysis",
        "joinType": "integration",
        "joinKeys": "[\"state_code\",\"year\"]",
        "methodology": "The researchers merged state‑level inflation estimates (Personal Consumption Expenditure change) from the Bureau of Economic Analysis with individual records from the Current Population Survey obtained via IPUMS. The BEA data were organized by state identifier and calendar year, representing the PCE"
      },
      "reviewRating": [
        {
          "@type": "Rating",
          "name": "join_confidence",
          "ratingValue": 8.5
        }
      ]
    },
    {
      "@type": "Review",
      "reviewAspect": "join",
