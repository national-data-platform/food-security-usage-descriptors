        "joinType": "fusion",
        "joinKeys": "[\"household_size\",\"housing_tenure\",\"year\"]",
        "methodology": "The researchers extracted the HRS file and the CEX summary table, transformed the CEX spending averages into annual poverty thresholds, and then applied those thresholds to each HRS household record. The join is a fusion where the CEX thresholds are merged based on household size and housing tenure."
      },
      "reviewRating": [
        {
          "@type": "Rating",
          "name": "join_confidence",
          "ratingValue": 8.7
        }
      ]
