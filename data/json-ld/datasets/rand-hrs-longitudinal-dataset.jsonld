    {
      "@type": "Review",
      "reviewAspect": "join",
      "reviewBody": "CPS data are used to generate official poverty rates and food‑insecurity statistics that serve as benchmarks for the HRS‑based analyses. The authors compare trends observed in the HRS with those reported from the CPS.",
      "citation": {
        "@type": "ScholarlyArticle",
        "name": "The dynamic nature of poverty and food insecurity among older adults: Evidence from the Health and Retirement Study",
