    {
      "@type": "Review",
      "reviewAspect": "join",
      "reviewBody": "The Supplemental Poverty Measure (SPM) thresholds used in the analysis are derived from five‑year average spending estimates from the CEX. These thresholds are applied to each HRS household to determine whether the household falls below the SPM poverty line.",
      "citation": {
        "@type": "ScholarlyArticle",
        "name": "The dynamic nature of poverty and food insecurity among older adults: Evidence from the Health and Retirement Study",
        "dud:publication_id": "pub.1151888645",
        "identifier": "10.1002/aepp.13329"
      },
      "dud:joinDetail": {
