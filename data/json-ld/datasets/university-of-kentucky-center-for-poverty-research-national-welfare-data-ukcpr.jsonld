    {
      "@type": "Review",
      "reviewAspect": "join",
      "reviewBody": "To control for macro‑economic and policy context, the authors augment the person‑level PSID data with state‑level variables from the UKCPR National Welfare Data for the years 1997 and 2019. These state‑level indicators are merged onto the PSID records based on the respondent’s state of residence.",
      "citation": {
        "@type": "ScholarlyArticle",
        "name": "The intergenerational transmission of food insecurity: Do educational compromises make things worse?",
        "dud:publication_id": "pub.1185960059",
        "identifier": "10.1002/soej.12767"
      },
      "dud:joinDetail": {
        "partnerDataset": "Panel Study of Income Dynamics (PSID) longitudinal sample",
        "joinType": "fusion",
        "joinKeys": "[\"state_id\",\"year\"]",
        "methodology": "The researchers extracted person level records from the PSID data set including the respondent state of residence and the survey year. They also extracted state level variables from the UKCPR data set for the years 1997 and 2019. A common key was created by combining the state identifier with the ye"
      },
